{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-chat",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_ORIGINS": "https://cade4christensen.github.io,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:8090,http://127.0.0.1:8090",
    "GEMINI_MODEL": "gemini-2.5-flash-lite"
  }
}
